# Gere um valor aleatório com pelo menos 32 caracteres. Não versione o valor real.
TRADINGVIEW_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters

# O servidor permanece estritamente em simulação; não existe opção de modo live.
# Opcional: caminho para outro JSON com a mesma estrutura do arquivo versionado.
OMS_SIMULATION_CONFIG=config/oms_simulation.json
OMS_KILL_SWITCH=false
