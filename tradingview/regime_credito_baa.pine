//@version=6
indicator("Fundo Multi-Sleeve — Regime de Crédito Baa", overlay=false)

// Spread entre títulos corporativos Baa da Moody's e Treasury de 10 anos.
fredSymbol = input.symbol("FRED:BAA10Y", "Série do spread Baa")
lookback = input.int(36, "Janela do z-score (meses)", minval=12)
entryZ = input.float(1.0, "Entrada em estresse", step=0.1)
exitZ = input.float(0.5, "Saída do estresse", step=0.1)

spread = request.security(fredSymbol, "M", close, barmerge.gaps_off, barmerge.lookahead_off)
meanSpread = ta.sma(spread, lookback)
stdSpread = ta.stdev(spread, lookback)
z = stdSpread > 0 ? (spread - meanSpread) / stdSpread : na

var bool stress = false
if barstate.isconfirmed and not na(z)
    if not stress and z > entryZ
        stress := true
    else if stress and z < exitZ
        stress := false

factorWeight = 33.0
smallWeight = stress ? 0.0 : 33.0
bilWeight = stress ? 67.0 : 33.0

plot(z, "z-score Baa", color=color.rgb(29, 78, 121), linewidth=2)
hline(entryZ, "Entrada", color=color.red, linestyle=hline.style_dashed)
hline(exitZ, "Saída", color=color.teal, linestyle=hline.style_dotted)
bgcolor(stress ? color.new(color.red, 84) : color.new(color.green, 91), title="Estado")

alertcondition(stress and not stress[1], "ENTRADA EM ESTRESSE", "Regime Baa entrou em estresse. Aplicar no próximo mês: Factor 33%, Small Caps 0%, BIL 67%.")
alertcondition(not stress and stress[1], "VOLTA AO NORMAL", "Regime Baa normalizou. Aplicar no próximo mês: Factor 33%, Small Caps 33%, BIL 33%.")

var table panel = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    stateColor = stress ? color.rgb(194, 65, 59) : color.rgb(42, 157, 143)
    table.cell(panel, 0, 0, "REGIME", text_color=color.white, bgcolor=color.rgb(18, 48, 74))
    table.cell(panel, 1, 0, stress ? "ESTRESSE" : "NORMAL", text_color=color.white, bgcolor=stateColor)
    table.cell(panel, 0, 1, "z-score")
    table.cell(panel, 1, 1, str.tostring(z, "#.##"))
    table.cell(panel, 0, 2, "Factor")
    table.cell(panel, 1, 2, str.tostring(factorWeight, "#") + "%")
    table.cell(panel, 0, 3, "Small Caps")
    table.cell(panel, 1, 3, str.tostring(smallWeight, "#") + "%")
    table.cell(panel, 0, 4, "BIL")
    table.cell(panel, 1, 4, str.tostring(bilWeight, "#") + "%")
